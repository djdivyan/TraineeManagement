{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { 
    "DefaultConnection":  
      "server={serverURL};port={port};database={db_name};user={user};password={pass};" ,
    "Redis": "localhost:6379,password={yourpassword},abortConnect=false"
  },
  "JwtConfig" : {
    "Issuer" : "http://localhost:5231/",
    "Audience":"http://localhost:5231/",
    "Key" : "ADD_YOUR_KEY_HERE",
    "TokenValidityMins" : 30
  } 
}
